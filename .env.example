# Copy to .env and replace every <...> value. Generate secrets with: openssl rand -hex 32
APP_ENV=production
APP_LOCALE=es
# Release installed from PyPI when building the image; empty builds this checkout.
CONNECTOR_PYPI_VERSION=0.1.0

# Keys for client applications (X-Api-Key), comma separated, at least 32 characters each.
API_KEYS=<api-key-for-data-curation-workspace>
# Token signing keys as <key id>:<secret>; the first one signs new tokens.
JWT_KEYS=2026-09:<jwt-secret>
JWT_ISSUER=limesurvey-connector

REDIS_PASSWORD=<redis-password>
CORS_ORIGINS=https://dcw.example.org
ALLOWED_LIMESURVEY_HOSTS=surveys.example.org
ALLOW_INSECURE_LIMESURVEY_HTTP=false
# For a LimeSurvey running on the Docker host, use localhost in ALLOWED_LIMESURVEY_HOSTS,
# ALLOW_INSECURE_LIMESURVEY_HTTP=true and LIMESURVEY_LOCALHOST_ALIAS=host.docker.internal.
LIMESURVEY_LOCALHOST_ALIAS=

SESSION_TTL_SECONDS=1800
CACHE_TTL_SECONDS=600
RATE_LIMIT_PER_MINUTE=60
LOGIN_RATE_LIMIT_PER_MINUTE=8
RESPONSES_RATE_LIMIT_PER_MINUTE=12
MAX_BODY_BYTES=10485760
LSS_MAX_BYTES=20971520

LS_REMOTE_CONNECT_TIMEOUT_SECONDS=5
LS_REMOTE_READ_TIMEOUT_SECONDS=30
LS_LOGIN_TIMEOUT_SECONDS=10
LS_SURVEYS_TIMEOUT_SECONDS=10
LS_SURVEY_LOAD_TIMEOUT_SECONDS=120
LS_RESPONSES_TIMEOUT_SECONDS=60
LS_RESPONSES_MAX_BYTES=20971520
LS_RESPONSES_MAX_FIELDS=500
LS_ACCOUNT_MAX_CONCURRENT_CALLS=8

LIMESURVEY_EXPECTED_VERSION=
LIMESURVEY_COMPATIBILITY_PROFILE=auto
# Optional per-survey aliases and ignored headers; see config/survey-configuration.example.json.
DICTIONARY_ALIASES_FILE=
