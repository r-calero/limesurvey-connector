{
  "description": "Remote LimeSurvey payload covering every supported native type.",
  "loadResultGolden": "limesurvey/remote/all-types.json",
  "aliasConfiguration": {
    "aliases": {
      "external_consent": "CONSIENTE"
    },
    "ignoredHeaders": [
      "Seed"
    ]
  },
  "questionCodes": [
    "APOYOS",
    "SATISF",
    "DUAL",
    "PRIORIDAD",
    "NOMBRE",
    "NO_EXISTE"
  ],
  "translations": [
    {
      "name": "records",
      "responseIdKey": "RID",
      "responses": [
        {
          "RID": 101,
          "NOMBRE": "Ana",
          "EDAD": 34,
          "CONSIENTE": "Y",
          "ESTADO": "-oth-",
          "ESTADO_OTHER_value": "Separada",
          "APOYOS_SQ001": "Y",
          "APOYOS_SQ002": "N",
          "SATISF_R1": "A2",
          "PRIORIDAD_1": "P3",
